# YAD Frontend ortam değişkenleri (Vite). Kopyala: .env.local

# API kaynağı: boş bırak → otomatik (Tauri içinde gerçek invoke, tarayıcıda mock).
# Zorla mock: true · Zorla gerçek backend: false
# VITE_USE_MOCK=

# Mock'u boş durumdan başlat (onboarding sihirbazını görmek için): true
# VITE_MOCK_EMPTY=
